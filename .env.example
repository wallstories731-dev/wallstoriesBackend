# ─── DB (Neon Postgres) ───────────────────────────────────────────
DB_URL=jdbc:postgresql://YOUR-NEON-HOST.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-me

# If tables live outside the default search_path, add currentSchema to DB_URL.
# The base backend schema must already exist; startup does not create tables.

# ─── Optional Elasticsearch ───────────────────────────────────────
# Disable when no ES service is running; search uses PostgreSQL instead.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200

# ─── JWT (>=32 random chars each; e.g. `openssl rand -base64 48`) ──
JWT_ACCESS_SECRET=replace-me-with-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string

# ─── App URLs ─────────────────────────────────────────────────────
# Public origin of the backend (used in outgoing email links).
APP_BASE_URL=http://localhost:8080/wallstories
# Where "Go to homepage" buttons in transactional emails point.
APP_HOME_URL=https://www.wallstories.vercel.app
# Optional: HTTP port (Render injects PORT automatically).
# PORT=8080
# CONTEXT_PATH=/wallstories

# ─── Razorpay (Standard Checkout) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=replace-me
# Set after creating the webhook in Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ─── Mail (Zoho SMTP) ─────────────────────────────────────────────
MAIL_ENABLED=true
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=Arusuvai Junction <no-reply@yourdomain.com>

# --- ZeptoMail HTTP API (use this on hosts that block SMTP, e.g. Render) ---
# When ZEPTOMAIL_TOKEN is set the SMTP_* config above is ignored.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email

# ─── Storage (Cloudflare R2 / S3 / local) ─────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=products
# Required: bucket Settings -> Public Development URL, or connected custom domain.
# Do NOT use the account's *.r2.cloudflarestorage.com storage API endpoint.
R2_PUBLIC_BASE_URL=
